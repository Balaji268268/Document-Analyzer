# DocSummarizer Environment Configuration Example
# Copy to .env for custom configuration

# Number of CPU threads for local GGUF inference (default: auto = half of available CPU cores)
DOCSUMMARIZER_THREADS=4

# Enable GPU acceleration (1 = enabled, 0 = disabled)
DOCSUMMARIZER_USE_GPU=0

# Custom directory for caching GGUF model files (default: %APPDATA%/DocSummarizer/models on Windows, ~/.local/share/DocSummarizer/models on Linux)
# DOCSUMMARIZER_MODELS_DIR=/path/to/models
